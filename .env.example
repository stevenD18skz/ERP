# Plantilla de variables de entorno. Copiar como .env.local y llenar los valores
# desde el dashboard de Supabase: tu proyecto -> Project Settings -> API
#
# IMPORTANTE: este archivo SÍ se sube a git (solo .env.local está ignorado, por
# la regla *.local del .gitignore). Aquí nunca van claves reales, solo el
# nombre de cada variable.

# Project URL. La raíz del proyecto, sin /rest/v1 al final.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Project API keys -> anon / public.
# Es pública: viaja al navegador. Con RLS activo no puede leer ni escribir nada
# por su cuenta; la app la usa solo para revisar que el proyecto responda.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project API keys -> service_role. SECRETA.
# Es la que usan las rutas de /api desde el servidor. Salta RLS y puede
# modificar cualquier tabla: no se comparte, no se pone en NEXT_PUBLIC_ y no
# se sube a git. Su lugar es .env.local (y las variables de entorno de Vercel).
SUPABASE_SERVICE_ROLE_KEY=
